<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.iocoder.boot</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>yudao-module-mate</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        mate 模块，觅搭校园找搭子平台的业务模块（唯一新增业务模块，扁平包分域）：
            auth(M1 认证) / match(M2 匹配) / risk(M6 风控) —— 后端甲
            im(M3 通讯) / trade(M4 交易会员) / content(M5 内容) / goods(M7 二手) —— 后端乙
    </description>

    <properties>
        <!-- 覆盖率不在此处配置 argLine：
             本项目 surefire 用 JarManifestForkConfiguration 启动 fork，pom 里的 argLine 传不进去，
             只能在命令行用 -DargLine 注入。见 scripts/coverage.sh -->
    </properties>

    <dependencies>
        <!-- 依赖 system 模块：复用 OAuth2TokenService 签发 C 端令牌、用户/权限基础能力 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 业务组件：多租户 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web + Security -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- WebSocket / STOMP：M3 在线直推。用 Spring 原生 STOMP（Principal 由拦截至 token 解析），
             不复用 yudao-spring-boot-starter-websocket 的 JSON 通道，避免与 /infra/ws 的 Handler 冲突 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- DB -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- Redis：缓存 / 分布式锁 / GEO -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- 消息队列：本地事件 / outbox -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-mq</artifactId>
        </dependency>

        <!-- 定时任务 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- Excel 导出 -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 架构守护：禁跨模块 import、禁 controller 直连 dal（规划 §8 铁律） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖率门禁：mvn test 后生成 target/site/jacoco/index.html。
                 prepare-agent 把 agent 参数写进自定义属性 surefireArgLine，
                 再由下面的 surefire 用 @{...} 延迟求值注入——直接改 argLine 在本项目不生效。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
